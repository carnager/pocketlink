<?xml version="1.0" encoding="utf-8"?>
<!-- Each paired computer is published as a dynamic shortcut in this category,
     which makes it a direct share target in the share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.carnager.pocketlink.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="io.github.carnager.pocketlink.category.COMPUTER" />
    </share-target>
</shortcuts>
