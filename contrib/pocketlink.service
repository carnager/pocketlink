[Unit]
Description=pocketlink phone companion daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/pocketlink daemon
Restart=on-failure
# Only stop the daemon itself: wl-copy children serve what it put on the
# clipboard, which would otherwise vanish on every restart.
KillMode=process
RestartSec=3

[Install]
WantedBy=graphical-session.target
